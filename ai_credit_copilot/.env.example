# Do not commit real credentials. Configure these in the terminal or deployment secret store.
QWEN_API_KEY=your_dashscope_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# The workbench defaults to qwen3.5. Replace this with the exact model ID enabled for your account when needed.
QWEN_MODEL=qwen3.5
QWEN_TIMEOUT_SECONDS=45
QWEN_MAX_TOKENS=1400
